table fact_polizas
	lineageTag: 814802c2-c788-4185-b8d5-94e5f045951f

	measure Debug_PolizasReno = [Polizas Renovadas]
		formatString: 0
		lineageTag: 7ed309c1-95b7-4738-9d81-dd186a7198df

	measure Debug_olizasQueVencen =
			
			VAR FechaMin = CALCULATE(MIN(dim_calendario[Fecha]))
			VAR FechaMax = CALCULATE(MAX(dim_calendario[Fecha]))
			RETURN
			    CALCULATE(
			        COUNTROWS(fact_polizas),
			        ALL(fact_polizas),
			        fact_polizas[Fin_Vigencia] >= FechaMin,
			        fact_polizas[Fin_Vigencia] <= FechaMax
			    )
		formatString: 0
		lineageTag: 75f31d1d-f4bd-41ec-9f7f-dc3d693a3e19


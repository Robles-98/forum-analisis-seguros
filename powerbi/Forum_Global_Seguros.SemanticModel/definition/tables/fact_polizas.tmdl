	column 'Antiguedad meses poliza' =
			
			DATEDIFF(
			    RELATED(dim_empleados[Fecha_Alta]),fact_polizas[Fecha_Emision],MONTH)
		formatString: 0
		lineageTag: defba35a-7672-40fe-ba38-c12244fcd0cf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Categoria poliza' = ```
			
			VAR mesesencampana = fact_polizas[Antiguedad meses poliza]
			VAR Resultado = 
			MAXX(
			    FILTER(
			    'Categorias Antiguedad',
			    mesesencampana >= 'Categorias Antiguedad'[MesesMin] &&
			    mesesencampana <= 'Categorias Antiguedad'[MesesMax]),'Categorias Antiguedad'[Categoria])
			
			RETURN Resultado
			```
		lineageTag: 5ff8d5f7-91d5-4dcd-b167-cd6dc2e5ed59
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_polizas = m
		mode: import
		source =
				let
				    Origen = MySQL.Database("localhost", "forum_global_seguros", [ReturnSingleDatabase=true]),
				    forum_global_seguros_vw_fact_polizas = Origen{[Schema="forum_global_seguros",Item="vw_fact_polizas"]}[Data]
				in

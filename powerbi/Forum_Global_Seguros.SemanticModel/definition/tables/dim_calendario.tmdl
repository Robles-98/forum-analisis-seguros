		annotation SummarizationSetBy = Automatic

	column Evento = ```
			
			
			VAR Fecha = dim_calendario[Fecha]
			VAR Resultado = 
			MAXX(
			    FILTER(
			        dim_temporadas,
			    Fecha >= dim_temporadas[Fecha_inicio] &&
			    Fecha <= dim_temporadas[Fecha_fin]),
			    dim_temporadas[evento])
			
			RETURN
			COALESCE(Resultado,"Normal")
			```
		lineageTag: f18675a0-2845-43bd-b0e4-ad9181fd99cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = m
		mode: import
		source =

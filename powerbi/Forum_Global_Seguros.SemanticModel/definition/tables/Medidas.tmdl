	measure 'HC por categoria' =
			
			VAR Fecha_corte = MAX(dim_calendario[Fecha])
			VAR MesesMin = SELECTEDVALUE('Categorias Antiguedad'[MesesMin])
			VAR MesesMax = SELECTEDVALUE('Categorias Antiguedad'[MesesMax])
			VAR Activos_al_corte=
			FILTER(
			    dim_empleados,
			    dim_empleados[Puesto] = "EJECUTIVO"
			    && dim_empleados[Fecha_Alta] <= Fecha_corte
			    && ( ISBLANK(dim_empleados[Fecha_Baja])
			        || dim_empleados[Fecha_Baja] > Fecha_corte)
			)
			VAR Activos_en_Categoria =
			FILTER(
			    Activos_al_corte,
			    VAR antiguedad = DATEDIFF(dim_empleados[Fecha_Alta],Fecha_corte,MONTH)
			    RETURN antiguedad >= MesesMin && antiguedad <= MesesMax
			)
			
			RETURN
			IF(
			    HASONEVALUE('Categorias Antiguedad'[Categoria]),
			    COUNTROWS(Activos_en_Categoria),
			    COUNTROWS(Activos_al_corte)
			)
		formatString: 0
		lineageTag: 03a33500-1951-479d-9601-b1644ec8466a


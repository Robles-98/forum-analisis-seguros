	measure 'Comportamiento Conversion' = ```
			
			VAR Metacampana = SELECTEDVALUE(dim_campanas[meta_conversion])
			VAR conversion = [% Conversion]
			VAR SinFiltros =
			NOT(ISFILTERED(dim_campanas[Campaña])) &&
			NOT(ISFILTERED(dim_calendario[Año])) &&
			NOT(ISFILTERED(dim_calendario[Mes]))
			VAR Sinoperacion =
			ISBLANK(conversion)
			
			VAR escalera = 
			    SWITCH(
			        TRUE(),
			        SinFiltros, "Conversion General 〽️",
			        Sinoperacion,"Sin Operacion ⛔",
			        ISBLANK(Metacampana),"Conversion General 〽️",
			        conversion >= Metacampana, "🟢Meta Alcanzada",
			        conversion >= (Metacampana *0.80),"🟡 Alcance Aceptable",
			        "🔴Requiere Atencion"
			    )
			RETURN escalera
			
			```
		displayFolder: 02 Conversion
		lineageTag: 8fe4ad3c-4972-4b55-b2ff-c30642ae3899

	measure 'Destino Meta Conversion' = SELECTEDVALUE(dim_campanas[meta_conversion])

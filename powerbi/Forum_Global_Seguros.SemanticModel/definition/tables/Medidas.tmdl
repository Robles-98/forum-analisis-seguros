	measure 'Clasificacion ejecutivo' = ```
			
			
			VAR FechaCorte =
			CALCULATE(
			    MAX(dim_calendario[Fecha]),
			    fact_polizas
			)
			VAR FechaBaja = 
			ADDCOLUMNS(
			    ADDCOLUMNS(
			        ADDCOLUMNS(
			        dim_empleados,
			        "Fecha Fin Antiguedad",
			        IF(ISBLANK(dim_empleados[Fecha_Baja]),FechaCorte,dim_empleados[Fecha_Baja])
			        ),
			        "Antiguedad en Meses",
			        DATEDIFF(dim_empleados[Fecha_Alta],[Fecha Fin Antiguedad],MONTH)
			        ),"Clasificacion",SWITCH(
			        TRUE(),
			        [Antiguedad en Meses] <= 3 , "Train",
			        [Antiguedad en Meses] <= 6 , "Gold",
			        [Antiguedad en Meses] <= 11, "Elite",
			        "Premier")
			)
			VAR MesesMin = SELECTEDVALUE('Categorias Antiguedad'[MesesMin])
			VAR MesesMax = SELECTEDVALUE('Categorias Antiguedad'[MesesMax])
			
			RETURN 
			    COUNTROWS(
			        FILTER(FechaBaja,
			        [Antiguedad en Meses] >=MesesMin &&
			        [Antiguedad en Meses] <= MesesMax)
			    )
			```
		formatString: 0
		displayFolder: 05 RRHH
		lineageTag: 362b52f1-f913-4d50-86f3-06a3373ea640

	measure 'Bajas x Categoria' =
			
			VAR InicioPeriodo = MIN (fact_leads[Fecha_de_contacto])
			VAR FinPeriodo = MAX ( fact_leads[Fecha_de_contacto] )
			VAR MesesMin = COALESCE ( SELECTEDVALUE ( 'Categorias Antiguedad'[MesesMin] ), 0 )
			VAR MesesMax = COALESCE ( SELECTEDVALUE ( 'Categorias Antiguedad'[MesesMax] ), 9999 )
			VAR Puente =
			    TREATAS ( VALUES ( dim_campanas[id_campana] ), dim_empleados[id_campana] )
			VAR BajasPeriodo =
			    CALCULATETABLE (
			        FILTER (
			            dim_empleados,
			            dim_empleados[Puesto] = "EJECUTIVO"
			                && NOT ISBLANK ( dim_empleados[Fecha_Baja] )
			                && dim_empleados[Fecha_Baja] >= InicioPeriodo
			                && dim_empleados[Fecha_Baja] <= FinPeriodo
			        ),
			        Puente
			    )
			VAR ConAntiguedad =
			    ADDCOLUMNS (
			        BajasPeriodo,
			        "Antiguedad en Meses", DATEDIFF ( dim_empleados[Fecha_Alta], dim_empleados[Fecha_Baja], MONTH )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            ConAntiguedad,
			            [Antiguedad en Meses] >= MesesMin
			                && [Antiguedad en Meses] <= MesesMax
			        )
			    )
		formatString: 0
		displayFolder: 05 RRHH
		lineageTag: 3f2422bc-051c-4afd-b004-747eb7085e9d


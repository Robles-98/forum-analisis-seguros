	measure '% Renovacion' = ```
			
			VAR Tipo = SELECTEDVALUE(fact_polizas[Tipo_Poliza])
			VAR PolizasReno = [Polizas Renovadas]
			
			VAR FechaMin = CALCULATE(MIN(dim_calendario[Fecha]))
			VAR FechaMax = CALCULATE(MAX(dim_calendario[Fecha]))
			
			VAR PolizasQueVencen =
			    CALCULATE(
			        COUNTROWS(fact_polizas),
			        ALL(fact_polizas),
			        fact_polizas[Fin_Vigencia] >= FechaMin,
			        fact_polizas[Fin_Vigencia] <= FechaMax,
			        fact_pagos[Estado_del_pago] IN {"Pagado","Pagado con Atraso"}
			    )
			        
			
			VAR Resultado =
			    IF(
			        Tipo = "Venta Nueva",
			        BLANK(),
			        DIVIDE(PolizasReno, PolizasQueVencen, 0)
			    )
			RETURN Resultado
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Renovaciones
		lineageTag: 2cfa9a4c-09b3-4052-97ea-82731fc661cb


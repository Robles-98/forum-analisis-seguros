	measure 'Dias Promedio Cierre' = ```
			
			CALCULATE(
			    AVERAGEX(
			        fact_polizas, 
			        
			        VAR FechaContacto = RELATED(fact_leads[Fecha_de_contacto]) 
			        VAR FechaEmision = fact_polizas[Fecha_Emision]
			        
			        RETURN
			        IF(
			            NOT ISBLANK(FechaContacto) && NOT ISBLANK(FechaEmision),
			            DATEDIFF(FechaContacto, FechaEmision, DAY), 
			            BLANK()
			        )
			    ),
			    USERELATIONSHIP(fact_polizas[id_lead], fact_leads[id_lead]),
			    fact_polizas[Tipo_Poliza] = "Venta Nueva"
			)
			```
		displayFolder: 01 ventas
		lineageTag: e31157bc-8e5f-4513-aff0-95b71ec9435d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Pagado a tiempo' = ```
			
			VAR TotalRecibos = COUNTROWS ( fact_pagos )
			VAR PagadosaTiempo =
			    CALCULATE (
			        COUNTROWS ( fact_pagos ),
			        NOT ISBLANK ( fact_pagos[Fecha_Pago] ),
			        fact_pagos[Fecha_Pago] <= fact_pagos[Fecha_Limite_Pago]
			    
			    )
			RETURN DIVIDE ( PagadosaTiempo, TotalRecibos, 0 )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Pagos
		lineageTag: a24a6533-c1d8-452f-b249-37a04505b04d

	measure '% Pagado con retraso' =
			
			VAR TotalRecibos = COUNTROWS(fact_pagos)
			VAR PagadosaDestiempo =
			CALCULATE(
			    COUNTROWS(fact_pagos),
			    fact_pagos[Fecha_Pago] > fact_pagos[Fecha_Limite_Pago]
			)
			VAR Resultado = DIVIDE(PagadosaDestiempo,TotalRecibos,0)
			RETURN Resultado
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Pagos
		lineageTag: 4fffd899-7f22-48a0-82b4-5a3b3293a198

	measure '% No Pagado' = ```
			
			VAR TotalRecibos = COUNTROWS(fact_pagos)
			VAR SinPago = 
			CALCULATE(
			    COUNTROWS(fact_pagos),
			    ISBLANK(fact_pagos[Fecha_Pago])
			)
			VAR Resultado = DIVIDE(SinPago,TotalRecibos)
			RETURN Resultado
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Pagos
		lineageTag: 0dbc843b-2a76-4fd9-8871-68f3ff7b9cec

	measure '% rotacion' = ```
			
			VAR empleadosVN =
			CALCULATE(
			    COUNTROWS(dim_empleados),
			    dim_empleados[id_area] IN{2,4},
			    TREATAS(
			        VALUES(dim_campanas[id_campana]),dim_empleados[id_campana]),
			    USERELATIONSHIP(dim_empleados[Fecha_Alta],dim_calendario[Fecha])
			)
			
			VAR Bajas = 
			CALCULATE(
			    COUNTROWS(dim_empleados),
			    dim_empleados[id_area] IN {2,4},
			    dim_empleados[estatus] = "INACTIVO",
			    TREATAS(
			        VALUES(dim_campanas[id_campana]),dim_empleados[id_campana]),
			    USERELATIONSHIP(dim_empleados[Fecha_Baja],dim_calendario[Fecha])
			)
			
			VAR rotacion = 
			DIVIDE(Bajas,empleadosVN,0)
			
			RETURN rotacion
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 RRHH
		lineageTag: 26920bbb-49a0-4292-9fb3-f59d4e446583

	measure '% de Rotacion x campaña' = ```
			
			VAR vInicioMes = MIN(dim_calendario[Fecha])
			VAR vFinMes = MAX(dim_calendario[Fecha])
			
			VAR vPuenteCampana = 
			    TREATAS( VALUES(dim_campanas[id_campana]), dim_empleados[id_campana] )
			VAR vPlantilla = 
			    CALCULATE(
			        COUNTROWS(dim_empleados),
			        FILTER(
			            dim_empleados,
			            dim_empleados[Fecha_Alta] <= vFinMes &&
			            (ISBLANK(dim_empleados[Fecha_Baja]) || dim_empleados[Fecha_Baja] >= vInicioMes)
			        ),
			        dim_empleados[id_area] IN {2, 4},
			        dim_empleados[Puesto] = "EJECUTIVO",
			        vPuenteCampana
			    )
			VAR vBajas = 
			    CALCULATE(
			        COUNTROWS(dim_empleados),
			        FILTER(
			            dim_empleados,
			            dim_empleados[Fecha_Baja] >= vInicioMes &&
			            dim_empleados[Fecha_Baja] <= vFinMes
			        ),
			        dim_empleados[id_area] IN {2, 4},
			        dim_empleados[Puesto] = "EJECUTIVO",
			        vPuenteCampana
			    )
			
			RETURN 
			    DIVIDE(vBajas, vPlantilla, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 RRHH
		lineageTag: 0e2b1292-bfcd-4f9c-89ee-f22da2b8b6a7

	measure 'Comportamiento Rotacion' = ```
			
			VAR rotacion = [% de Rotacion x campaña]
			VAR SinFiltros = 
			NOT(ISFILTERED(dim_calendario[Año])) &&
			NOT(ISFILTERED(dim_calendario[Mes])) &&
			NOT(ISFILTERED(dim_campanas[Campaña]))
			
			VAR Comportamiento = 
			SWITCH(
			    TRUE(),
			    SinFiltros,"Promedio historico Global",
			    ISBLANK(rotacion), "Sin Rotacion",
			    rotacion < 0.05, "Baja ✅",
			    rotacion < 0.08, "Manejable 〽️",
			    rotacion <0.15, "Inestable 🛑",
			    rotacion > 0.15, "Critica ❌"
			)
			
			RETURN Comportamiento
			```
		displayFolder: 05 RRHH
		lineageTag: 7d05472f-8a24-4c16-b753-bd694f185a2a

	measure 'Ejecutivos Activos x Categoria' = ```
			
			VAR FechaCorte = 
			CALCULATE(
			    MAX(dim_calendario[Fecha]),
			    fact_leads,
			    REMOVEFILTERS('Categorias Antiguedad')
			)
			VAR MesesMin = COALESCE ( SELECTEDVALUE ( 'Categorias Antiguedad'[MesesMin] ), 0 )
			VAR MesesMax = COALESCE ( SELECTEDVALUE ( 'Categorias Antiguedad'[MesesMax] ), 9999 )
			VAR Puente =
			    TREATAS ( VALUES ( dim_campanas[id_campana] ), dim_empleados[id_campana] )
			VAR ActivosAlCorte =
			    CALCULATETABLE (
			        FILTER (
			            dim_empleados,
			            dim_empleados[Puesto] = "EJECUTIVO"
			                && dim_empleados[Fecha_Alta] <= FechaCorte
			                && ( ISBLANK ( dim_empleados[Fecha_Baja] )
			                     || dim_empleados[Fecha_Baja] > FechaCorte )
			        ),
			        Puente
			    )
			VAR ConAntiguedad =
			    ADDCOLUMNS (
			        ActivosAlCorte,
			        "Antiguedad en Meses", DATEDIFF ( dim_empleados[Fecha_Alta], FechaCorte, MONTH )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            ConAntiguedad,
			            [Antiguedad en Meses] >= MesesMin
			                && [Antiguedad en Meses] <= MesesMax
			        )
			    )
			```
		formatString: 0
		displayFolder: 05 RRHH
		lineageTag: 26a019a5-addf-4abd-a6b1-63a1e980519d


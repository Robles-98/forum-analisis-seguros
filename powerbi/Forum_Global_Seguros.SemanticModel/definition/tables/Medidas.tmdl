	measure 'HC ejecutivos' = ```
			
			VAR Fecha_Corte = MAX(dim_calendario[Fecha])
			VAR Activos_al_Corte = 
			    FILTER(
			        dim_empleados,
			        dim_empleados[Puesto] = "EJECUTIVO"
			        && dim_empleados[Fecha_Alta] <= Fecha_Corte
			        && (ISBLANK(dim_empleados[Fecha_Baja])
			            || dim_empleados[Fecha_Baja] > Fecha_Corte))
			RETURN 
			COUNTROWS(Activos_al_Corte)
			```
		formatString: 0
		lineageTag: 2d54c336-0cd0-4e8f-b9b6-38e02e72a904

	measure 'Altas HC' =
			
			VAR Fecha_Inicio = MIN(dim_calendario[Fecha])
			VAR Fecha_Fin = MAX(dim_calendario[Fecha])
			
			VAR Altas_Periodo =
			FILTER(
			    dim_empleados,
			    dim_empleados[Puesto] = "EJECUTIVO"
			    && dim_empleados[Fecha_Alta] >= Fecha_Inicio
			    && dim_empleados[Fecha_Alta] <= Fecha_Fin)
			RETURN
			COUNTROWS(Altas_Periodo)
		formatString: 0
		lineageTag: 5eb14ec9-2578-4d0d-a429-a228a30707b5

	measure 'Bajas HC' = ```
			
			VAR Fecha_Inicio = MIN(dim_calendario[Fecha])
			VAR Fecha_Fin = MAX(dim_calendario[Fecha])
			
			VAR Bajas_Periodo =
			FILTER(
			    dim_empleados,
			    dim_empleados[Puesto] = "EJECUTIVO"
			    && dim_empleados[Fecha_Baja] >= Fecha_Inicio
			    && dim_empleados[Fecha_Baja] <= Fecha_Fin)
			RETURN
			COUNTROWS(Bajas_Periodo)
			
			```
		formatString: 0
		lineageTag: ef33cb3f-a0b5-40c0-a0ac-09caa2f01fa2

	measure '% Rotacion HC' =
			
			VAR HC_Final = [HC ejecutivos]
			VAR HC_Inicial = (HC_Final-[Altas HC]+[Bajas HC])
			VAR HC_Promedio = (HC_Inicial+HC_Final) / 2
			RETURN
			DIVIDE(
			    COALESCE([Bajas HC],0),HC_Promedio)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8ae80d21-341e-4919-8268-d803cfa3fef1

	measure 'Antiguedad promedio (Meses)' =
			
			VAR Fecha_Corte = MAX( dim_calendario[Fecha] )
			VAR Activos_al_Corte =
			    FILTER(
			        dim_empleados,
			        dim_empleados[Puesto] = "EJECUTIVO"
			            && dim_empleados[Fecha_Alta] <= Fecha_Corte
			            && ( ISBLANK( dim_empleados[Fecha_Baja] )
			                || dim_empleados[Fecha_Baja] > Fecha_Corte )
			    )
			RETURN
			    AVERAGEX(
			        Activos_al_Corte,
			        ( DATEDIFF( dim_empleados[Fecha_Alta], Fecha_Corte, DAY ) + 1 ) / 30.44
			    )
		lineageTag: 2c40c383-0ff6-420c-a669-eca2512c55f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HC supervisores' =
			
			VAR Fecha_Corte = MAX(dim_calendario[Fecha])
			VAR Supervisores_Activos =
			FILTER(
			    dim_empleados,
			    dim_empleados[Puesto] = "SUPERVISOR"
			    && dim_empleados[Fecha_Alta] <= Fecha_Corte
			    && ( ISBLANK(dim_empleados[Fecha_Baja])
			        || dim_empleados[Fecha_Baja] > Fecha_Corte)
			
			)
			
			RETURN
			COUNTROWS(Supervisores_Activos)
		formatString: 0
		lineageTag: ee57533b-526f-405c-ba4b-95cb8008445f


	measure 'Ventas por Canal' =
			
						CALCULATE(
							COUNTROWS(fact_polizas),
							USERELATIONSHIP(fact_polizas[id_lead],fact_leads[id_lead]),
			                CROSSFILTER(dim_calendario[Fecha],fact_leads[Fecha_de_contacto],None))
		formatString: #,0
		displayFolder: 01 ventas
		lineageTag: 37e74760-3d44-4bde-a414-f4a35978244e

	measure '% Conversion' =
			
			VAR tipo = SELECTEDVALUE(fact_polizas[Tipo_Poliza])
			
			VAR TotalLEADS =
			    IF(
			        tipo = "Renovacion",
			        BLANK(),
			        COUNTROWS(fact_leads)
			    )
			
			VAR TotalPolizas =
			    CALCULATE(
			        [Total polizas],
			        fact_polizas[Tipo_Poliza] = "Venta Nueva",
			        USERELATIONSHIP(fact_polizas[id_lead], fact_leads[id_lead]),
			        CROSSFILTER(dim_calendario[Fecha], fact_leads[Fecha_de_contacto], NONE),
			        fact_pagos[Estado_del_pago] IN {"Pagado","Pagado con Atraso"}
			    )
			
			VAR Resultado = DIVIDE(TotalPolizas, TotalLEADS)
			RETURN Resultado
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Conversion
		lineageTag: 7e2b0ad5-8111-4af4-a600-e56fb91d68f6

	measure 'Leads Totales' = ```
			
			VAR tipo = SELECTEDVALUE(fact_polizas[Tipo_Poliza])
			VAR Resultado = 
			IF(
			 tipo = "Renovacion",
			 BLANK(),
			 COUNTROWS(fact_leads))
			
			 RETURN Resultado

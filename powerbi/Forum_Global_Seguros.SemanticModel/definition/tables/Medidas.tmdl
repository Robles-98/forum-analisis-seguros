	measure 'Meses Activo ATC' =
			
			VAR Puesto = SELECTEDVALUE(dim_empleados[Puesto])
			VAR Area = SELECTEDVALUE(dim_empleados[id_area])
			VAR AltaEmpleado = MIN(dim_empleados[Fecha_Alta])
			VAR BjaEmpleado = MAX(dim_empleados[Fecha_Baja])
			VAR InicioPeriodo = MIN(dim_calendario[Fecha])
			VAR FinPeriodo = MAX(dim_calendario[Fecha])
			
			VAR InicioReal = MAX(AltaEmpleado,InicioPeriodo)
			VAR FinReal = MIN(COALESCE(BjaEmpleado,FinPeriodo),FinPeriodo)
			
			RETURN
			SWITCH(
			    TRUE(),
			    InicioReal > FinReal , BLANK(),
			    Puesto <> "Ejecutivo" , BLANK(),
			    Area <> 5, BLANK(),
			    ( DATEDIFF( InicioReal, FinReal, DAY ) + 1 ) / 30.44
			)
		formatString: 0.0
		displayFolder: 06 ATC\Productividad
		lineageTag: 2802691e-6ca7-48ca-b8ea-0da5c7bcd2f0

	measure 'Meses persona ATC' =
			

	column Fecha_y_Hora_de_Contacto
		dataType: dateTime
		formatString: General Date
		lineageTag: ca9448b7-c8fb-4b26-b875-06ec1ce1e598
		summarizeBy: none
		sourceColumn: Fecha_y_Hora_de_Contacto

		annotation SummarizationSetBy = Automatic

	column 'Antiguedad en meses' =
			
			DATEDIFF(
			    RELATED(dim_empleados[Fecha_Alta]),fact_leads[Fecha_de_contacto],MONTH)
		formatString: 0
		lineageTag: 54d4f6d7-e30d-47aa-9191-1279766af4a2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Categoria LEAD' = ```
			
			VAR mesesencampana = fact_leads[Antiguedad en meses]
			VAR Resultado = 
			MAXX(
			    FILTER(
			        'Categorias Antiguedad',
			        mesesencampana >= 'Categorias Antiguedad'[MesesMin] &&
			        mesesencampana <= 'Categorias Antiguedad'[MesesMax]),'Categorias Antiguedad'[Categoria]
			)
			
			RETURN Resultado
			```
		lineageTag: 031f3c92-a3cb-4e41-8046-46eedf1a3a14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_leads = m
		mode: import
		source =
				let
				    Origen = MySQL.Database("localhost", "forum_global_seguros", [ReturnSingleDatabase=true]),
				    forum_global_seguros_vw_fact_leads = Origen{[Schema="forum_global_seguros",Item="vw_fact_leads"]}[Data]
				in
